{
  "permissions": {
    "allow": [
      "Bash(python *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(type *)",
      "Bash(psql *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_no_edit_changes.py"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python .claude/hooks/check_no_edit_changes.py"
          }
        ]
      }
    ]
  }
}
