# Zigurat ERP — Credenciales de Base de Datos (PLANTILLA)
# Copiar como .env y completar con los valores reales.
# El .env real NUNCA va al repositorio (está en .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dte_facturas_chile
DB_USER=postgres
DB_PASSWORD=cambiar-por-la-clave-real

# Réplica en la nube (proyecto InsForge zigurat-movil)
# Copiar desde el panel de InsForge: Install → Direct Connect → Connection String
INSFORGE_DB_URL=

# Secret propio (HS256) que verifican las cloud functions de Zigurat Movil.
# Generar con: python -c "import secrets; print(secrets.token_urlsafe(48))"
INSFORGE_JWT_SECRET=

# URL base de las cloud functions desplegadas (no es secreta).
# Ej: https://<proyecto>.functions.insforge.app
INSFORGE_FUNCTIONS_URL=

# API de OpenAI para generar el MP3 del informe diario; nunca versionar la clave real.
OPENAI_API_KEY=
