# Zigurat ERP — Credenciales de Base de Datos (PLANTILLA)
# Copiar como .env y completar con los valores reales.
# El .env real NUNCA va al repositorio (está en .gitignore).

DB_HOST=localhost
DB_PORT=5432
DB_NAME=dte_facturas_chile
DB_USER=postgres
DB_PASSWORD=cambiar-por-la-clave-real

# Réplica en la nube (proyecto InsForge zigurat-movil)
# Copiar desde el panel de InsForge: Install → Direct Connect → Connection String
INSFORGE_DB_URL=
